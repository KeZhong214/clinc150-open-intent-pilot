# Local-only API configuration for the classroom demo.
# Copy this file to configs/demo_api.env and fill in a valid key.
# Never commit demo_api.env and never paste the key into chat or a screenshot.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=12
